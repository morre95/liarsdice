{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/liars-dice/config.schema.json",
  "title": "Liar's Dice configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "host": { "type": "string", "default": "127.0.0.1" },
    "port": { "type": "integer", "minimum": 0, "maximum": 65535, "default": 0, "description": "0 selects an available port." },
    "publicDir": { "type": "string", "default": "public" },
    "matchId": { "type": "string", "minLength": 1 },
    "matchToken": { "type": "string", "minLength": 1, "description": "Shared secret required by agent WebSockets." },
    "players": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 2, "maxItems": 2 },
    "dicePerPlayer": { "type": "integer", "minimum": 1, "default": 5 },
    "seed": { "type": "integer", "default": 0 },
    "turnDeadlineMs": { "type": "integer", "minimum": 0, "default": 0, "description": "0 disables turn deadlines." },
    "disconnectGraceMs": { "type": "integer", "minimum": 0, "default": 0, "description": "0 penalizes a disconnected current player immediately." },
    "tokenBudget": { "type": ["integer", "null"], "minimum": 0, "default": null, "description": "Per-agent cumulative budget; null means unlimited." },
    "maxMoveBytes": { "type": "integer", "minimum": 1, "default": 16384 },
    "exactCall": { "type": "boolean", "default": false },
    "palifico": { "type": "boolean", "default": false },
    "spotOnReward": { "type": "boolean", "default": false },
    "illegalRetries": { "type": "integer", "minimum": 0, "default": 2 },
    "maxPenalties": { "type": "integer", "minimum": 1, "default": 3 },
    "penaltyStarter": { "type": "string", "enum": ["penalized", "opponent"], "default": "penalized" },
    "maxTableTalkLength": { "type": "integer", "minimum": 0, "default": 280 },
    "omniscientSpectators": { "type": "boolean", "default": false },
    "showSpectatorReasoning": { "type": "boolean", "default": false },
    "eventLogPath": { "type": "string", "minLength": 1 },
    "replayPath": { "type": "string", "minLength": 1 },
    "replayStrict": { "type": "boolean", "default": false },
    "replaySpeed": { "type": "number", "minimum": 0, "default": 1 },
    "seeds": { "type": "array", "items": { "type": "integer" }, "minItems": 1 },
    "matches": { "type": "integer", "minimum": 1 },
    "logDir": { "type": "string", "minLength": 1, "description": "Directory receiving one match JSONL event log per headless match." },
    "resultsPath": { "type": "string", "minLength": 1 },
    "ratings": { "type": "object", "additionalProperties": { "type": "number" }, "default": {} },
    "kFactor": { "type": "number", "exclusiveMinimum": 0, "default": 32 }
  },
  "required": ["matchId", "matchToken", "players"]
}
